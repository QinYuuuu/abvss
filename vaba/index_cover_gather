package vaba

import (
	"fmt"
	"sync"
	"time"
)

const (
	RaMsg      string = "RA_MSG"     // For reliable agreement messages
	WITHDRAW   string = "WITHDRAW"   // For withdraw notifications
	VALIDATION string = "VALIDATION" // For party validation notifications
)

// Message defines the structure for protocol messages
type Message struct {
	Type    string
	Content interface{}
	SenderID  int
	RAIndex   int // For identifying which RA instance the message belongs to
}

// IndexCoverGatherImpl represents a participant in the protocol
type IndexCoverGatherImpl struct {
	id, n, t                int              // Fault tolerance threshold

	// State for Index Cover Gather Protocol
	Valid            map[int]bool  // Set of parties that pi has validated so far
	IGValid          map[int]bool  // Input/output of the index gather protocol
	Withdraw         bool          // Whether party has withdrawn
	WithdrawReceived map[int]bool  // Tracks received WITHDRAW messages

	// Reliable Agreement instances
	RAInstances      []*RAImpl

	// Communication channels
	send     func()

	// Final output
	Output           []int         // Set Xi (indices of validated parties)
	Terminated       bool          // Whether protocol has terminated

	mutex            sync.Mutex    // For thread safety
}

// NewIndexCoverGatherImpl creates a new party instance for the protocol
func NewIndexCoverGatherImpl(id, n, t int) *IndexCoverGatherImpl {
	return &IndexCoverGatherImpl{
		id:               id,
		n:                n,
		t:                t,
		Valid:            make(map[int]bool),
		IGValid:          make(map[int]bool),
		Withdraw:         false,
		WithdrawReceived: make(map[int]bool),
		MessageQueue:     make(chan Message, 1000),
		Terminated:       false,
	}
}

// SendToAll sends a message to all parties including self
func (p *IndexCoverGatherImpl) SendToAll(msgType string, content interface{}, raIndex int) {
	msg := Message{
		Type:     msgType,
		Content:  content,
		SenderID: p.id,
		RAIndex:  raIndex,
	}

	for _, peer := range p.Peers {
		msgCopy := Message{
			Type:     msg.Type,
			Content:  msg.Content,
			SenderID: msg.SenderID,
			RAIndex:  msg.RAIndex,
		}
		peer.MessageQueue <- msgCopy
	}

	// Also send to self
	p.MessageQueue <- msg
}

// InitializeRAInstances sets up the required reliable agreement instances
func (p *IndexCoverGatherImpl) InitializeRAInstances() {
	p.RAInstances = make([]*RAImpl, p.N)
	for j := 0; j < p.N; j++ {
		p.RAInstances[j] = NewRAImpl(p.id, )
	}
}

// ValidateParty is called when party i has validated party j
func (p *IndexCoverGatherImpl) ValidateParty(j int) {
	p.mutex.Lock()
	defer p.mutex.Unlock()

	// Skip if already validated
	if p.Valid[j] {
		return
	}

	// Add to validated set
	p.Valid[j] = true
	fmt.Printf("IndexCoverGatherImpl %d validated party %d\n", p.id, j)

	// If not withdrawn yet, provide input 1 to corresponding RA instance
	if !p.Withdraw {
		p.RAInstances[j].InputProvided = true
		p.RAInstances[j].Input = 1

		// Simulate RA protocol by broadcasting the input
		p.SendToAll(RaMsg, 1, j)
		fmt.Printf("IndexCoverGatherImpl %d input 1 to RA[%d]\n", p.id, j)
	}
}

// HandleRAMessage processes a message for a reliable agreement instance
func (p *IndexCoverGatherImpl) HandleRAMessage(msg Message) {
	p.mutex.Lock()
	defer p.mutex.Unlock()

	raIndex := msg.RAIndex
	input, ok := msg.Content.(int)
	if !ok || raIndex < 0 || raIndex >= p.N {
		return // Invalid message
	}

	// In a real implementation, this would be a proper RA protocol
	// For simplicity, we'll just simulate RA by accepting the first input
	// and making everyone agree on it

	ra := p.RAInstances[raIndex]
	if !ra.Complete {
		// Simulate RA by simply using the first non-zero input as output
		if input == 1 {
			ra.Output = 1
			ra.Complete = true

			// Handle RA output
			fmt.Printf("IndexCoverGatherImpl %d: RA[%d] outputs 1\n", p.id, raIndex)

			// Add to IGValid
			p.IGValid[raIndex] = true

			// Check if we have n-t validated parties
			if len(p.IGValid) == p.N-p.T && !p.Withdraw {
				p.Withdraw = true
				// Send WITHDRAW to all
				fmt.Printf("IndexCoverGatherImpl %d sending WITHDRAW to all\n", p.id)
				p.SendToAll(WITHDRAW, nil, -1)
			}
		}
	}
}

// HandleWithdrawMessage processes a WITHDRAW message
func (p *IndexCoverGatherImpl) HandleWithdrawMessage(msg Message) {
	p.mutex.Lock()
	defer p.mutex.Unlock()

	senderID := msg.SenderID
	p.WithdrawReceived[senderID] = true
	fmt.Printf("IndexCoverGatherImpl %d received WITHDRAW from party %d\n", p.id, senderID)

	// Check if we've received WITHDRAW from n-t parties
	if len(p.WithdrawReceived) >= p.N-p.T && !p.Terminated {
		// Wait until the index gather protocol outputs Xi
		// In a real implementation, we would wait for the actual index gather output
		// For simplicity, we'll use IGValid as our output Xi

		// Convert map keys to slice for output
		xi := make([]int, 0, len(p.IGValid))
		for j := range p.IGValid {
			xi = append(xi, j)
		}

		p.Output = xi
		p.Terminated = true

		fmt.Printf("IndexCoverGatherImpl %d outputs Xi = %v and terminates\n", p.id, xi)
	}
}

// Run starts the party's protocol execution
func (p *IndexCoverGatherImpl) Run() {
	fmt.Printf("IndexCoverGatherImpl %d started Index Cover Gather Protocol\n", p.id)

	for {
		if p.Terminated {
			return
		}

		select {
		case msg := <-p.MessageQueue:
			switch msg.Type {
			case RaMsg:
				p.HandleRAMessage(msg)
			case WITHDRAW:
				p.HandleWithdrawMessage(msg)
			case VALIDATION:
				j, ok := msg.Content.(int)
				if ok {
					p.ValidateParty(j)
				}
			}
		default:
			time.Sleep(10 * time.Millisecond)
		}
	}
}

// SimulateValidationEvents generates validation events for testing
func SimulateValidationEvents(parties []*IndexCoverGatherImpl) {
	// Let each party validate a few other parties
	for i, party := range parties {
		// Simulate party i validating some parties
		for j := 0; j < len(parties); j++ {
			if i != j {
				// IndexCoverGatherImpl i validates party j
				// In reality, this would happen based on some external validation logic
				msg := Message{
					Type:     VALIDATION,
					Content:  j,
					SenderID: i,
				}
				party.MessageQueue <- msg

				// Add some delay between validations
				time.Sleep(100 * time.Millisecond)
			}
		}
	}
}

func main() {
	// Example setup with 4 parties, tolerating 1 fault (t=1)
	n := 4
	t := 1

	// Create parties
	parties := make([]*IndexCoverGatherImpl, n)
	for i := 0; i < n; i++ {
		parties[i] = NewParty(i, n, t)
	}

	// Set peers for each party
	for i := 0; i < n; i++ {
		var peers []*IndexCoverGatherImpl
		for j := 0; j < n; j++ {
			if i != j {
				peers = append(peers, parties[j])
			}
		}
		parties[i].SetPeers(peers)
	}

	// Initialize RA instances for each party
	for i := 0; i < n; i++ {
		parties[i].InitializeRAInstances(parties)
	}

	// Start the protocol for each party
	for i := 0; i < n; i++ {
		go parties[i].Run()
	}

	// Simulate validation events to test the protocol
	go SimulateValidationEvents(parties)

	// Wait for protocol to complete
	time.Sleep(5 * time.Second)

	// Check results
	for i := 0; i < n; i++ {
		if parties[i].Terminated {
			fmt.Printf("IndexCoverGatherImpl %d final output: %v\n", i, parties[i].Output)
		} else {
			fmt.Printf("IndexCoverGatherImpl %d did not complete the protocol\n", i)
		}
	}
}